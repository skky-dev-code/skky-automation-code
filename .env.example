# ===== Notion =====
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 두 환경의 데이터베이스 ID — Notion DB URL의 32자리 부분
NOTION_DATABASE_TEST=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DATABASE_PROD=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion DB의 컬럼명 매핑 (선택)
NOTION_PROP_CODE=대학코드
NOTION_PROP_NAME=대학명
NOTION_PROP_TIER=신청등급

# ===== Naver 메일 (SMTP / IMAP) =====
NAVER_USER=youraccount@naver.com
NAVER_PASS=xxxxxxxxxxxx

MAIL_FROM_NAME=SKKY Consulting
MAIL_SUBJECT_PRIMARY=K-NSSE / UICA 참여 안내
MAIL_SUBJECT_SECONDARY=K-NSSE / UICA 참여 안내 (리마인드)

# 수신자 이메일이 들어있는 Notion 컬럼명
MAIL_RECIPIENT_COL=담당자 이메일

PORT=3000

# ===== 공유 상태 저장소 (발송/회신 상태) =====
# 로컬은 .data/ JSON 파일로 자동 동작 — 아래 변수는 불필요.
# Vercel은 Storage→Upstash Redis 연동 시 KV_REST_API_URL/KV_REST_API_TOKEN을
# 자동 주입하며 store.js가 이를 자동 인식함 (별도 설정 불필요).
# 직접 설정하려면 아래 둘을 채우면 됨. 모두 비어있으면 파일 모드(서버리스에선 영구 저장 안 됨).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
